{
  "expo": {
    "name": "GabiTrainer",
    "slug": "gabitrainer",
    "scheme": "gabitrainer",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "backgroundColor": "#f5ead8",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "app.gabitrainer.klient"
    },
    "android": {
      "package": "app.gabitrainer.klient",
      "adaptiveIcon": {
        "backgroundColor": "#f5ead8",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "single",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-router",
        {
          "asyncRoutes": {
            "web": false
          }
        }
      ],
      "expo-font",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#f5ead8",
          "image": "./assets/splash-icon.png",
          "imageWidth": 76
        }
      ],
      "expo-image",
      [
        "expo-image-picker",
        {
          "photosPermission": "GabiTrainer potrzebuje dostępu do zdjęć, żeby dodać zdjęcia sylwetki do raportu tygodniowego.",
          "cameraPermission": false
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
